# URL the Next.js server uses to reach the API (server-side only; never exposed to the browser).
API_URL=http://127.0.0.1:5000
# Public site URL (used for metadata / absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=ReadnShare

# Business details shown on the Contact, About and policy pages (payment gateways check these).
# Leave empty to hide. Set them in Vercel → Settings → Environment Variables, then redeploy.
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_PHONE=
# City/state whose courts handle disputes, e.g. "Ahmedabad, Gujarat"
NEXT_PUBLIC_BUSINESS_JURISDICTION=
