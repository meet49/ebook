# ─── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Public URL of the Next.js web app (used for links in emails and CORS/origin checks)
APP_URL=http://localhost:3000
# Comma-separated extra origins allowed to make state-changing requests
ALLOWED_ORIGINS=
# Set to the number of reverse proxies in front of the API in production (e.g. 1)
TRUST_PROXY=0
# Long random string (>= 32 chars). Used to hash IPs and sign non-session values.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ─── Database ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/ebook?replicaSet=rs0&directConnection=true
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ebook
# Optional: DNS servers for Node, if mongodb+srv:// fails with "querySrv ECONNREFUSED" (e.g. 8.8.8.8,1.1.1.1)
DNS_SERVERS=

# ─── Sessions ────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=ebook_sid
SESSION_TTL_DAYS=30

# ─── Email ───────────────────────────────────────────────────────────────
# "smtp" for any SMTP provider (Postmark, SES, Resend, Brevo, ...).
# "brevo" sends through Brevo's HTTPS API (needs BREVO_API_KEY) — use it where SMTP ports
# are blocked, e.g. on Render's free plan.
# "console" prints emails to the API log — development only; refused in production.
EMAIL_TRANSPORT=console
EMAIL_FROM="ReadnShare <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
BREVO_API_KEY=

# ─── Private file storage ────────────────────────────────────────────────
# "local" keeps files in STORAGE_DIR (development only; refused in production).
# "s3" uses any S3-compatible service: AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO.
STORAGE_DRIVER=local
STORAGE_DIR=./storage
MAX_PDF_MB=200
MAX_COVER_MB=5
# Width in pixels that PDF pages are rendered at for the reader
PAGE_RENDER_WIDTH=1400
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ebook-private
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ─── Razorpay ─────────────────────────────────────────────────────────────
# Use TEST MODE keys (rzp_test_...) during development. Dashboard → Settings → API Keys.
# Webhook secret: Dashboard → Settings → Webhooks (events: payment.captured, payment.failed,
# order.paid, refund.processed, refund.failed).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Affiliate program ───────────────────────────────────────────────────
ATTRIBUTION_WINDOW_DAYS=30
COMMISSION_HOLD_DAYS=7
# Minimum payout request, in paise (50000 = ₹500)
MIN_PAYOUT_PAISE=50000

# ─── Seed (used once by `npm run seed:admin`) ───────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator
