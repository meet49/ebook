{
  "name": "@ebook/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:admin": "tsx --env-file-if-exists=.env src/scripts/seed-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/lib-storage": "^3.1152.0",
    "@ebook/shared": "*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.0",
    "helmet": "^8.1.0",
    "mongoose": "^9.11.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pino": "^10.1.1",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.3.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
